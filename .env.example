# Frontend Supabase Config
#
# The production build REFUSES to run without these two. Missing, they make
# src/lib/supabase.ts resolve to a null stub, Rollup tree-shakes the whole
# Supabase client out, and the build still succeeds - shipping an app that
# cannot reach the database with nothing to show for it. See vite.config.ts.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend API URL
VITE_API_URL=http://localhost:8000

# Optional flags
#
# Build a deliberately database-less bundle (demo/offline). Only set this when
# that is genuinely what you want - it is the opt-out from the check above.
# VITE_ALLOW_NO_SUPABASE=true
#
# Enforce the paywall. Every screen is reachable unless this is 'true'.
# VITE_ENFORCE_PAYWALL=true
#
# Error reporting.
# VITE_SENTRY_DSN=
